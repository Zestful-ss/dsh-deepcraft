  "motion": [
    {
      "token": "--dsh-deepcraft-duration-feedback",
      "value": "120ms",
      "use": "a control answering hover, press or focus: its colour, background, border, shadow, or a small turn or slide of its own parts"
    },
    {
      "token": "--dsh-deepcraft-duration-exit",
      "value": "120ms",
      "use": "a surface leaving on the reader’s dismissal: a menu or a dialog closing"
    },
    {
      "token": "--dsh-deepcraft-duration-open",
      "value": "250ms",
      "use": "a surface growing out of its anchor: a menu out of its trigger, a full-window dialog out of the centre, a settings page sliding in"
    },
    {
      "token": "--dsh-deepcraft-duration-slide",
      "value": "240ms",
      "use": "the segmented controls' sliding highlight, a sidebar icon's quarter turn, the wording box taking the width of the words arriving, and streamed content sliding up from the bottom edge"
    }, {
      "token": "--dsh-deepcraft-duration-island-float",
      "value": "1.7s",
      "use": "the island mascot's idle loop and its wake-up float"
    }, {
      "token": "--dsh-deepcraft-duration-island-type",
      "value": "0.52s",
      "use": "the island mascot's working-state cycle and the drag lift"
    }, {
      "token": "--dsh-deepcraft-duration-island-focus",
      "value": "1.15s",
      "use": "the island mascot's waiting stare: the head tilt and the eyes narrowing"
    }, {
      "token": "--dsh-deepcraft-duration-island-hop",
      "value": "0.72s",
      "use": "the island mascot's celebration: the hop and its sparkles"
    }, {
      "token": "--dsh-deepcraft-duration-island-shake",
      "value": "0.4s",
      "use": "the island mascot's failed-state shake"
    }, {
      "token": "--dsh-deepcraft-duration-island-sleep",
      "value": "2.6s",
      "use": "the island mascot's sleeping breath"
    }, {
      "token": "--dsh-deepcraft-duration-island-lean",
      "value": "0.32s",
      "use": "the island mascot's poke lean"
    }, {
      "token": "--dsh-deepcraft-ease-island-hop",
      "value": "cubic-bezier(0.2, 0.9, 0.2, 1)",
      "use": "the island mascot's hop curve, from the reference theme's island keyframes"
    }, {
      "token": "--dsh-deepcraft-ease-island-cycle",
      "value": "ease-in-out",
      "use": "the island mascot's breathing cycles: float, type, focus, shake and sleep"
    }, {
      "token": "--dsh-deepcraft-ease-island-out",
      "value": "ease-out",
      "use": "the island mascot's one-off releases: the sparkles and the poke lean"
    },
    {
      "token": "--dsh-deepcraft-duration-fade",
      "value": "300ms",
      "use": "a slow cross-fade: the theme flip, a placeholder handing its place to what it stood for"
    },
    {
      "token": "--dsh-deepcraft-duration-bounce",
      "value": "350ms",
      "use": "a switch's knob travelling across with its double bounce",
      "note": "transitions.dev's \"Toggle\" (MIT)."
    },
    {
      "token": "--dsh-deepcraft-duration-reduced",
      "value": "0.01ms",
      "use": "every skin animation and transition under the Reduced animation choice (D40)",
      "note": "Not zero: a transition whose duration and delay are both zero never starts and fires no transitionend, so anything listening for its end would wait forever."
    },
    {
      "token": "--dsh-deepcraft-ease-standard",
      "value": "ease",
      "use": "feedback and surfaces: the default curve"
    },
    {
      "token": "--dsh-deepcraft-ease-glide",
      "value": "cubic-bezier(0.22, 0.61, 0.36, 1)",
      "use": "travel along a track: the sliding highlight, a settings page’s slide"
    },
    {
      "token": "--dsh-deepcraft-ease-spring",
      "value": "cubic-bezier(0.34, 1.45, 0.64, 1)",
      "use": "a small overshoot as something lands: a switch’s knob bouncing past its end"
    },
    {
      "token": "--dsh-deepcraft-ease-settle",
      "value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "use": "a surface or a page settling into place out of its anchor: menus and dialogs opening and closing, a settings page sliding"
    },
    {
      "token": "--dsh-deepcraft-distance-travel",
      "value": "8px",
      "use": "a settings page’s slide"
    },
    {
      "token": "--dsh-deepcraft-blur-enter",
      "value": "3px",
      "use": "the blur a settings page or a line of the home greeting passes through as it slides or rises in"
    },
    {
      "token": "--dsh-deepcraft-scale-dropdown",
      "value": "0.97",
      "use": "the scale a menu grows from out of its trigger"
    },
    {
      "token": "--dsh-deepcraft-scale-dropdown-exit",
      "value": "0.99",
      "use": "the scale a menu shrinks to while it fades on closing"
    },
    {
      "token": "--dsh-deepcraft-timing-feedback",
      "value": "var(--dsh-deepcraft-duration-feedback) var(--dsh-deepcraft-ease-standard)",
      "use": "shorthand: a control's state change, written after the property in a transition"
    },
    {
      "token": "--dsh-deepcraft-duration-material-fast",
